# The Linux script execution control securebits need Linux 6.14+, capsh(1)
# to set them, and a bash configured with --enable-exec-check.
# 0x100 is SECBIT_EXEC_RESTRICT_FILE, 0x400 is SECBIT_EXEC_DENY_INTERACTIVE;
# capsh only takes numeric securebits
if ! capsh --secbits=0x500 --shell=/bin/true -- -c true >/dev/null 2>&1; then
	echo "warning: skipping execcheck tests: capsh missing or the script execution control securebits are unsupported" >&2
	exit 0
fi
# a shell that honors SECBIT_EXEC_DENY_INTERACTIVE refuses to run -c
if capsh --secbits=0x400 --shell=${THIS_SH} -- -c true >/dev/null 2>&1; then
	echo "warning: skipping execcheck tests: bash was not configured with --enable-exec-check" >&2
	exit 0
fi
${THIS_SH} ./execcheck.tests > ${BASH_TSTOUT} 2>&1
diff ${BASH_TSTOUT} execcheck.right && rm -f ${BASH_TSTOUT}
